# Copie para .env.local e preencha. NUNCA versione o .env.local.

# ─── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Supabase (Project Settings → API / Database) ─────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Conexão com pooler (porta 6543) para o app, direta (porta 5432) para migrations
DATABASE_URL=postgresql://postgres.SEU-PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.SEU-PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# ─── Asaas (comece SEMPRE no sandbox) ─────────────────────────────────────
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
# walletId da conta-mãe da plataforma: recebe os 5% via split
PLATFORM_WALLET_ID=
# Chave para cifrar as chaves de API das subcontas no banco (32 bytes em base64)
GATEWAY_KEYS_ENCRYPTION_KEY=

# ─── Ingressos ────────────────────────────────────────────────────────────
# Segredo do QR Code (mínimo 32 caracteres). Gere com: openssl rand -base64 48
TICKET_SECRET=

# ─── E-mail (Resend) ──────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Plataforma de Ingressos <ingressos@seudominio.com.br>"
